# Copy this file to .env and fill in what you have. .env is never committed.

# AI layer (Claude). Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# SCAMTRACE_MODEL=claude-sonnet-5-5

# Instagram / Facebook: Meta Ad Library API token
META_ACCESS_TOKEN=

# TikTok: Commercial Content API app credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Secret used to hash identifiers. Change it in any real deployment.
SCAMTRACE_HASH_KEY=demo-hash-key
