# Copy this file to .env and fill in what you have. .env is never committed.

# ---- AI layer -------------------------------------------------------
# Which model reads posts and screenshots:
#   claude (default) | openai | gemini | ollama | openai_compatible | heuristic
SCAMTRACE_PROVIDER=claude
# Model name. Optional for claude; required for the others (check each
# provider's current model list, names change often).
# SCAMTRACE_MODEL=

# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com
GEMINI_API_KEY=
# Local open-weights models via Ollama need no key (http://localhost:11434).
# Any other OpenAI-compatible server (vLLM, hosted open models):
# SCAMTRACE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# Instagram / Facebook: Meta Ad Library API token
META_ACCESS_TOKEN=

# TikTok: Commercial Content API app credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Secret used to hash identifiers. Change it in any real deployment.
SCAMTRACE_HASH_KEY=demo-hash-key
